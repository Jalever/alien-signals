{
	"name": "native-signals",
	"version": "0.0.1",
	"license": "MIT",
	"type": "commonjs",
	"packageManager": "pnpm@9.12.0",
	"files": [
		"**/*.js",
		"**/*.d.ts"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johnsoncodehk/native-signals.git"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"debug": "ts-node -P tsconfig-ts-node.json --transpile-only debug-example.ts",
		"debug:link": "ts-node -P tsconfig-ts-node.json --transpile-only link-debug.ts",
		"debug:graph": "ts-node -P tsconfig-ts-node.json --transpile-only dependency-graph-debug.ts",
		"debug:flow": "ts-node -P tsconfig-ts-node.json --transpile-only flow-tracer.ts",
		"debug:snapshot": "ts-node -P tsconfig-ts-node.json --transpile-only link-snapshot-debug.ts",
		"debug:custom": "ts-node -P tsconfig-ts-node.json --transpile-only custom-debug.ts"
	},
	"devDependencies": {
		"vite": "latest",
		"vitest": "latest",
		"typescript": "latest",
		"ts-node": "latest"
	}
}
